<IfModule mod_rewrite.c>
  RewriteEngine On

  # When GoDaddy's document root is set to this public/ folder instead of
  # the project root, incoming URLs like /public/event.php resolve to
  # public/public/event.php (404). Strip the extra /public/ prefix and
  # redirect so the file is served correctly from this directory.
  RewriteCond %{REQUEST_URI} ^/public/(.*)$
  RewriteRule ^public/(.*)$ /$1 [R=301,L]
</IfModule>
