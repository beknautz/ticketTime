# TicketTime Environment Configuration
# Copy this to .env and configure for your environment.
# On shared hosting, set these values in config/database.php etc. directly.

# ── Application ───────────────────────────────────────────────
APP_ENV=production
SITE_URL=https://yourdomain.com
TZ=America/Chicago

# ── Database ──────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tickettime
DB_USER=dbuser
DB_PASS=dbpassword

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Mail ──────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.your_sendgrid_api_key
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME=TicketTime
MAIL_FROM_ADDRESS=tickets@yourdomain.com
MAIL_REPLY_TO=support@yourdomain.com

# ── Support ───────────────────────────────────────────────────
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=(555) 000-0000
